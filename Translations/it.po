msgstr "tasche"

#. help for parameter pockets
#: boxes/generators/carbonfilter.py
msgid "number of V shaped filter pockets"
msgstr "numero di tasche filtranti a V"

#. parameter name
#: boxes/generators/carbonfilter.py
