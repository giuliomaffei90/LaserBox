#. name of box generator
#: boxes/generators/traylayout.py
msgid "TrayLayout"
msgstr "Vassoio da schema"

#. description of TrayLayout
#: boxes/generators/traylayout.py
msgid "Generate a typetray from a layout file."
msgstr "Genera un vassoio con scomparti a partire da uno schema."

msgid "TrayLayout Settings"
msgstr "Impostazioni vassoio da schema"

#. help for parameter layout
#: boxes/generators/traylayout.py
msgid ""
"* Set **sx** and **sy** before editing this!\n"
"* You can still change measurements afterwards\n"
"* You can replace the hyphens and vertical bars representing the walls\n"
"with a space character to remove the walls.\n"
"* You can replace the space characters representing the floor by a \"X\"\n"
"to remove the floor for this compartment.\n"
"* Resize text area if necessary."
msgstr ""
"* Imposta **sx** e **sy** prima di modificare questo schema!\n"
"* Potrai comunque cambiare le misure in seguito\n"
"* Puoi sostituire i trattini e le barre verticali che rappresentano le "
"pareti\n"
"con uno spazio per eliminarle.\n"
"* Puoi sostituire gli spazi che rappresentano il fondo con una \"X\"\n"
"per eliminare il fondo di quello scomparto.\n"
"* Se necessario, ridimensiona l'area di testo."

